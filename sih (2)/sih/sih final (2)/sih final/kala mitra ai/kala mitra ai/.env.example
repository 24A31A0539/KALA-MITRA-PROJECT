# ==============================================================================
# KALA-MITRA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure your local settings.
# Do NOT commit sensitive API secrets or keys to version control.
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Payment Gateway (Razorpay TEST MODE)
# Get your test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_kalamitra2026
RAZORPAY_KEY_SECRET=test_secret_kala_mitra_sih
RAZORPAY_MODE=TEST

# AI & LLM Service Configuration
# Default connects to local Ollama daemon (localhost:11434).
# If Ollama is offline, KALA-MITRA falls back to the internal domain expert engine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
FALLBACK_LLM_MODEL=mistral

# Computer Vision Model Checkpoints (Optional local weights)
YOLO_MODEL_PATH=models/yolov8n.pt
SAM_CHECKPOINT_PATH=models/sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b

# Persistence Data Store Filepath
DATA_STORE_PATH=backend/app/data/store.json

# ==============================================================================
# REAL OTP DISPATCH CONFIGURATION (Email & Mobile SMS)
# ==============================================================================

# Real Email OTP (SMTP Server - e.g. Gmail App Password, SendGrid, Brevo, AWS SES)
# Leave empty to print generated OTPs to server console for testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=auth@kalamitra.org
SMTP_FROM_NAME=KALA-MITRA AI
SMTP_TLS=True

# Real Mobile SMS Gateway (Options: 'twilio', 'fast2sms', 'msg91', 'console')
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

FAST2SMS_API_KEY=your_fast2sms_api_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

