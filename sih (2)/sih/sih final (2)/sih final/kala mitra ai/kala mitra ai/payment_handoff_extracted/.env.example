# ==============================================================================
# KALA-MITRA PAYMENT MODULE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS FOR PAYMENT DEVELOPER:
# 1. Copy this file to '.env' in your local environment:
#      cp .env.example .env
# 2. DO NOT commit your '.env' file or production API keys to git.
# 3. For local development & testing without gateway credentials, keep:
#      PAYMENT_PROVIDER=mock
# 4. When ready to test with Razorpay Sandbox/Test mode, set:
#      PAYMENT_PROVIDER=razorpay
#      and supply your test Key ID and Key Secret from the Razorpay Dashboard.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1
DEFAULT_CURRENCY=INR

# Active Payment Provider: 'mock' (default) or 'razorpay'
PAYMENT_PROVIDER=mock

# Mock Payment Behavior (For local frontend testing without keys)
# Set to True to simulate automatic successful checkouts
MOCK_PAYMENT_AUTO_SUCCESS=True

# ==============================================================================
# RAZORPAY CONFIGURATION (Test / Sandbox Mode)
# ==============================================================================
# Obtain from Razorpay Dashboard -> Settings -> API Keys
# Test keys start with 'rzp_test_'
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET_HERE

# Webhook Security Settings
# Maximum allowable age (in seconds) of timestamped webhook payloads to prevent replay attacks
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
