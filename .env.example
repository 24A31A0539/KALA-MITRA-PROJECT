# ==============================================================================
# KALA-MITRA ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env in your application directory and configure your settings.
# WARNING: NEVER commit your actual .env file or real secrets to Git/GitHub!
# ==============================================================================

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000

# Payment Gateway (Razorpay Sandbox / Test Mode)
# Obtain test credentials from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=placeholder_secret_key
RAZORPAY_MODE=TEST

# AI & LLM Service Configuration
# Default connects to a local Ollama daemon (http://localhost:11434).
# If Ollama is offline, KALA-MITRA falls back cleanly to the built-in domain knowledge engine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
FALLBACK_LLM_MODEL=mistral

# Computer Vision Model Checkpoints (Optional local weights)
# If weight files are absent, services gracefully fall back to bounding box / heuristic modes.
YOLO_MODEL_PATH=models/yolov8n.pt
SAM_CHECKPOINT_PATH=models/sam_vit_b_01ec64.pth
SAM_MODEL_TYPE=vit_b

# Persistence Data Store Filepath (JSON File-based store)
DATA_STORE_PATH=backend/app/data/store.json

# ==============================================================================
# OTP DISPATCH CONFIGURATION (Email & Mobile SMS)
# ==============================================================================

# Email OTP (SMTP Server - e.g. Gmail App Password, Brevo, AWS SES)
# Leave SMTP_HOST empty to print generated OTPs directly to the backend server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_app_specific_password
SMTP_FROM_EMAIL=auth@kalamitra.org
SMTP_FROM_NAME=KALA-MITRA AI
SMTP_TLS=True

# Mobile SMS Gateway Configuration
# Supported options: 'console', 'twilio', 'fast2sms', 'msg91'
# Set to 'console' for local testing without external SMS provider accounts.
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_sid

FAST2SMS_API_KEY=your_fast2sms_api_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

# ==============================================================================
# FRONTEND / VITE CLIENT CONFIGURATION
# (Used by Vite during browser bundling)
# ==============================================================================
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
